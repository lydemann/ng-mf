{
  "name": "shared-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:ui"],
  "generators": {
    "@nxext/stencil:component": {
      "style": "scss"
    }
  },
  "targets": {
    "test": {
      "executor": "@nxext/stencil:test",
      "outputs": ["{options.outputPath}"],
      "options": {
        "projectType": "library",
        "tsConfig": "libs/shared/ui/tsconfig.lib.json",
        "configPath": "libs/shared/ui/stencil.config.ts",
        "outputPath": "dist/libs/shared/ui"
      }
    },
    "build": {
      "executor": "@nxext/stencil:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "projectType": "library",
        "tsConfig": "libs/shared/ui/tsconfig.lib.json",
        "configPath": "libs/shared/ui/stencil.config.ts",
        "outputPath": "dist/libs/shared/ui"
      },
      "configurations": {
        "production": {
          "dev": false,
          "prod": true
        }
      }
    },
    "serve": {
      "executor": "@nxext/stencil:serve",
      "outputs": ["{options.outputPath}"],
      "options": {
        "projectType": "library",
        "tsConfig": "libs/shared/ui/tsconfig.lib.json",
        "configPath": "libs/shared/ui/stencil.config.ts",
        "outputPath": "dist/libs/shared/ui"
      }
    },
    "e2e": {
      "executor": "@nxext/stencil:e2e",
      "outputs": ["{options.outputPath}"],
      "options": {
        "projectType": "library",
        "tsConfig": "libs/shared/ui/tsconfig.lib.json",
        "configPath": "libs/shared/ui/stencil.config.ts",
        "outputPath": "dist/libs/shared/ui"
      }
    },
    "lint": {
      "executor": "@nx/eslint:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": "libs/shared/ui/**/*.{ts,tsx}"
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run shared-ui:serve",
          "nx run shared-ui:serve-storybook"
        ],
        "parallel": true
      }
    },
    "serve-storybook": {
      "executor": "@nx/storybook:storybook",
      "options": {
        "port": 4400,
        "configDir": "libs/shared/ui/.storybook",
        "config": {
          "dependsOn": ["shared-ui:build"],
          "configFolder": "libs/shared/ui/.storybook",
          "framework": {
            "name": "@storybook/web-components-vite"
          }
        }
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@nx/storybook:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "uiFramework": "@storybook/html-webpack5",
        "outputPath": "dist/storybook/shared-ui",
        "config": {
          "configFolder": "libs/shared/ui/.storybook"
        }
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    }
  }
}
