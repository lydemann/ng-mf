{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.14.0",
    "useDocker": true,
    "generators": {
      "typescript-angular": {
        "inputSpec": "openapi.yaml",
        "output": "src/generated/angular",
        "generatorName": "typescript-angular",
        "additionalProperties": {
          "supportsES6": "true",
          "withInterfaces": "true",
          "fileNaming": "kebab-case",
          "stringEnums": "true",
          "enumPropertyNaming": "UPPERCASE",
          "modelPropertyNaming": "camelCase",
          "paramNaming": "camelCase",
          "serviceSuffix": "Service",
          "serviceFileSuffix": ".service",
          "modelSuffix": "",
          "modelFileSuffix": ".model",
          "apiPackage": "api",
          "modelPackage": "model"
        }
      },
      "typescript-nestjs": {
        "inputSpec": "openapi.yaml",
        "output": "src/generated/nestjs",
        "generatorName": "typescript-nestjs",
        "additionalProperties": {
          "supportsES6": "true",
          "withInterfaces": "true",
          "classTransformer": "true",
          "classValidator": "true",
          "fileNaming": "kebab-case",
          "stringEnums": "true",
          "enumPropertyNaming": "UPPERCASE",
          "modelPropertyNaming": "camelCase",
          "paramNaming": "camelCase"
        }
      }
    }
  }
}
